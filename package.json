{
  "name": "cortico-world-douyin-live",
  "version": "0.1.6",
  "type": "module",
  "description": "Cortico World: read-only Douyin live room (room-id ingest like bilibili; optional local bridge), with coalescing, audience admission and a local OBS overlay",
  "license": "GPL-3.0-or-later",
  "author": "accdji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/accdji/cortico-world-douyin-live.git"
  },
  "bugs": {
    "url": "https://github.com/accdji/cortico-world-douyin-live/issues"
  },
  "homepage": "https://github.com/accdji/cortico-world-douyin-live#readme",
  "keywords": [
    "cortico-world",
    "cortico",
    "douyin",
    "streaming",
    "tiktok"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "抖音直播间",
    "icon": "src/icon.svg",
    "webUiClient": "dist/webui.js",
    "describe": "describe.json",
    "tags": [
      "streaming",
      "unofficial-api",
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "抖音直播间",
        "description": "只读接入抖音直播弹幕、礼物与人流；填房间号即可，可选本机 OBS Overlay。"
      },
      "en": {
        "displayName": "Douyin Live",
        "description": "Read-only Douyin live chat, gifts and audience signals by room id; optional local OBS overlay."
      }
    }
  },
  "files": [
    "src",
    "dist",
    "vendor",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:webui": "node scripts/build-webui.mjs",
    "mock:bridge": "node scripts/mock-dycast-forward.mjs"
  },
  "dependencies": {
    "protobufjs": "7.6.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "cortico": "^0.2.9",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
